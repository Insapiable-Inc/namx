      "name": "bypass-sweep",
      "bypass": true,
      "signal": {
        "type": "sweep",
        "f0": 20,
        "f1": 20000,
        "seconds": 10,
        "level_db": -12,
        "tail": 2
      },
      "note": "MODE on STANDARD for the whole plan. Guitar In, Output A only (nothing in B)."
    },
    {
      "name": "bypass-bursts",
      "bypass": true,
