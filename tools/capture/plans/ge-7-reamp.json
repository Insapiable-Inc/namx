{
  "pedal": "Boss GE-7 Equalizer",
  "comment": "Reamp: the same recorded guitar (captures/di/phrases.wav, `capture.py di`, played as hard as it was played) through the pedal at a few settings, for a by-ear A/B against NAM-X's type with the same DI and settings. Positions on the printed scale, as in plans/ge-7.json.",
  "quiet_dbfs": -60,
  "knobs": [
    "100 Hz",
    "200 Hz",
    "400 Hz",
    "800 Hz",
    "1.6 kHz",
    "3.2 kHz",
    "6.4 kHz",
    "Level"
  ],
  "takes": [
    {
      "name": "bypass-di",
      "bypass": true,
      "signal": {
        "type": "file",
        "path": "captures/di/phrases.wav",
        "tail": 2
      }
    },
    {
      "name": "di-mid-boost",
      "settings": {
        "100 Hz": "-5",
        "200 Hz": "0",
        "400 Hz": "+5",
        "800 Hz": "+10",
        "1.6 kHz": "+7.5",
        "3.2 kHz": "0",
        "6.4 kHz": "-5",
        "Level": "0"
      },
      "signal": {
        "type": "file",
        "path": "captures/di/phrases.wav",
        "tail": 2
      }
    },
    {
      "name": "di-scoop",
      "settings": {
        "100 Hz": "+5",
        "200 Hz": "+5",
        "400 Hz": "-5",
        "800 Hz": "-10",
        "1.6 kHz": "-5",
        "3.2 kHz": "+5",
        "6.4 kHz": "+7.5",
        "Level": "0"
      },
      "signal": {
        "type": "file",
        "path": "captures/di/phrases.wav",
        "tail": 2
      }
    },
    {
      "name": "di-lead-level",
      "settings": {
        "100 Hz": "0",
        "200 Hz": "0",
        "400 Hz": "+5",
        "800 Hz": "+5",
        "1.6 kHz": "+5",
        "3.2 kHz": "0",
        "6.4 kHz": "0",
        "Level": "+10"
      },
      "signal": {
        "type": "file",
        "path": "captures/di/phrases.wav",
        "tail": 2
      }
    }
  ]
}
