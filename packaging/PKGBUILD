# Maintainer: silvercobraa <claude@pichulero.cl>
# AUR package for NAM Player. Builds from the tagged source tree (submodules
# vendored through the release tarball produced by .github/workflows/release.yml).
pkgname=nam-player
pkgver=1.0.0
pkgrel=1
pkgdesc="Standalone Neural Amp Modeler player: models, IRs, effects chain, library, TONE3000"
arch=('x86_64')
url="https://github.com/silvercobraa/NeuralAmpModelerGUI"
license=('MIT')
depends=('qt6-base' 'jack' 'alsa-lib') # jack = jack2 or pipewire-jack; alsa-lib = MIDI input
optdepends=('pipewire-jack: run without a JACK daemon'
            'qpwgraph: patch the JACK ports graphically')
makedepends=('cmake' 'ninja' 'git')
provides=('namplayer')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/nam-player-$pkgver-src.tar.gz")
sha256sums=('SKIP') # filled in by the release job / maintainer at publish time

build() {
    cd "$srcdir/nam-player-$pkgver"
    cmake -S gui -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DNAM_NATIVE_OPT=OFF \
        -DNAM_TONE3000_CLIENT_ID="${NAM_TONE3000_CLIENT_ID:-}"
    cmake --build build
}

package() {
    cd "$srcdir/nam-player-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
