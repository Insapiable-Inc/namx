# Maintainer: silvercobraa <claude@pichulero.cl>
# AUR package for NAM-X. Builds from the tagged source tree (submodules
# vendored through the release tarball produced by .github/workflows/release.yml).
pkgname=namx
pkgver=0.0.0
pkgrel=1
pkgdesc="Standalone Neural Amp Modeler player: models, IRs, effects chain, library"
arch=('x86_64')
url="https://github.com/Insapiable-Inc/namx"
license=('GPL-3.0-or-later' 'MIT') # app GPL; bundled NAM core MIT
depends=('qt6-base' 'jack' 'alsa-lib') # jack = jack2 or pipewire-jack; alsa-lib = MIDI input
optdepends=('pipewire-jack: run without a JACK daemon'
            'qpwgraph: patch the JACK ports graphically')
makedepends=('cmake' 'ninja')
source=("$pkgname-$pkgver.tar.gz::$url/releases/download/v$pkgver/namx-$pkgver-src.tar.gz")
# The release job publishes this file with the tarball's checksum filled in
# (release.yml → PKGBUILD asset); otherwise run `updpkgsums` before pushing to the AUR.
sha256sums=('SKIP')

build() {
    cd "$srcdir/namx-$pkgver"
    # makepkg.conf adds -D_GLIBCXX_ASSERTIONS, which makes every vector index a checked
    # access — the convolution, delay lines and resamplers index per sample on the
    # real-time thread, and an assertion there aborts the app mid-performance.
    export CXXFLAGS="${CXXFLAGS//-Wp,-D_GLIBCXX_ASSERTIONS/}"
    cmake -S . -B build -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr \
        -DNAM_NATIVE_OPT=OFF
    cmake --build build
}

package() {
    cd "$srcdir/namx-$pkgver"
    DESTDIR="$pkgdir" cmake --install build
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
    install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
}
