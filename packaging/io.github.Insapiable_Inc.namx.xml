<?xml version="1.0" encoding="UTF-8"?>
<!-- shared-mime-info: file types NAM-X opens (installed to
     share/mime/packages; run update-mime-database after installing). -->
<mime-info xmlns="http://www.freedesktop.org/standards/shared-mime-info">
  <mime-type type="application/x-nam">
    <comment>Neural Amp Modeler profile</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.nam"/>
    <icon name="io.github.Insapiable_Inc.namx"/>
  </mime-type>
  <mime-type type="application/x-nampreset">
    <comment>NAM-X preset</comment>
    <sub-class-of type="application/json"/>
    <glob pattern="*.nampreset"/>
    <icon name="io.github.Insapiable_Inc.namx"/>
  </mime-type>
</mime-info>
