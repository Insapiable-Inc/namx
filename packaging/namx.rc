// Windows resources: executable icon + version block.
#include <windows.h>

IDI_ICON1 ICON "../resources/icons/namx.ico"

// CMake passes NAM_VERSION ("0.0.0") and the three numeric parts from PROJECT_VERSION.
#ifndef NAM_VERSION
#define NAM_VERSION "0.0.0"
#endif
#ifndef NAM_VERSION_MAJOR
#define NAM_VERSION_MAJOR 0
#define NAM_VERSION_MINOR 0
#define NAM_VERSION_PATCH 0
#endif

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    NAM_VERSION_MAJOR,NAM_VERSION_MINOR,NAM_VERSION_PATCH,0
 PRODUCTVERSION NAM_VERSION_MAJOR,NAM_VERSION_MINOR,NAM_VERSION_PATCH,0
 FILEFLAGSMASK  VS_FFI_FILEFLAGSMASK
 FILEFLAGS      0
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "pichulero.cl"
            VALUE "FileDescription",  "NAM-X"
            VALUE "FileVersion",      NAM_VERSION
            VALUE "InternalName",     "namx"
            VALUE "OriginalFilename", "namx.exe"
            VALUE "ProductName",      "NAM-X"
            VALUE "ProductVersion",   NAM_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
